{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Worker report: .herd/results/t<task>-<hex>.json. Checked by scripts/check-report.ps1 -Kind worker.",
  "type": "object",
  "additionalProperties": false,
  "required": ["nonce", "task", "model", "status", "scope_sha", "files", "tests", "verification", "break_checks", "deviations", "blocked_question"],
  "properties": {
    "nonce": { "type": "string", "pattern": "^t[0-9]+(-[0-9]+)*-[0-9a-f]{4}$" },
    "task": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "status": { "enum": ["done", "blocked"] },
    "scope_sha": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "change"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "change": { "enum": ["added", "modified", "deleted"] }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test", "covers"],
        "properties": {
          "test": { "type": "string", "minLength": 1, "$comment": "file::name" },
          "covers": { "type": "string", "minLength": 1, "$comment": "spec scenario / contract item it pins" }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "result", "summary"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "result": { "enum": ["pass", "fail", "not_run"] },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "break_checks": {
      "type": "array",
      "$comment": "Test tasks only; empty otherwise.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["broke", "failing_tests", "restored"],
        "properties": {
          "broke": { "type": "string", "minLength": 1, "$comment": "file:line and what was changed" },
          "failing_tests": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "restored": { "type": "boolean", "$comment": "git diff -- <product path> was empty afterwards" }
        }
      }
    },
    "deviations": {
      "type": "array",
      "$comment": "Places where the code departs from the literal spec/design text, with the reason.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "what", "why"],
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "what": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    },
    "blocked_question": { "type": ["string", "null"], "$comment": "Required text when status is blocked; null otherwise." }
  }
}
